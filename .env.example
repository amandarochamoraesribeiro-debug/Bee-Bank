# Banco de dados local (SQLite via arquivo) — usado automaticamente em desenvolvimento
# se TURSO_DATABASE_URL não estiver definido. Não precisa ser configurado localmente.
# TURSO_DATABASE_URL="file:./local.db"

# Produção (Vercel): crie um banco gratuito em https://turso.tech (libSQL, compatível com SQLite)
# e preencha as duas variáveis abaixo em Project Settings > Environment Variables.
TURSO_DATABASE_URL="libsql://seu-banco.turso.io"
TURSO_AUTH_TOKEN="seu-token-aqui"
